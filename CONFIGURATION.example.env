# Innominds IIPP example deployment configuration. Export variables before ./deploy.sh.
# No API keys or credentials belong in this file or source control.
AWS_REGION=ap-south-1
TARGET_INSTANCE_ID=i-0d3e9dedd07108137
ENABLE_COST_EXPLORER=true
COST_EXPLORER_REGION=us-east-1
AWS_PRICING_API_REGION=us-east-1
AZURE_PRICING_REGION=centralindia
GCP_PRICING_REGION=asia-south1
CLOUDPILOT_PRICE_CACHE_TTL_SECONDS=300
CLOUDPILOT_AWS_DISCOVERY_CANDIDATES=12

# Default: Amazon Bedrock / Nova Micro setup using the EC2 IAM role.
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0

# Optional provider selection: openai, anthropic, gemini, local
# Set the matching key securely in the deployment shell/secret manager; deploy.sh
# stores it in a user-only file and mounts it read-only inside the container.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_LLM_MODEL=local-model
# LOCAL_LLM_API_KEY=
# GOOGLE_CLOUD_BILLING_API_KEY= # GCP public pricing only, not a GCP account connection

# Both write paths disabled by default. Enable only after IAM/security review.
ENABLE_APPROVAL_EXECUTION=false
IIPP_KUBERNETES_TIMEOUT_SECONDS=3600
IIPP_SERVER_TIMEOUT_SECONDS=900
ENABLE_TERRAFORM_WORKFLOW=false

# Terraform remote state (required before enabling the Terraform workflow)
TF_STATE_BUCKET=inframind-tfstate-704298683641-20261104
TF_STATE_REGION=ap-south-1
TF_STATE_PREFIX=iipp/deployments
TF_PLUGIN_CACHE_DIR=/terraform-plugin-cache
IIPP_ALLOWED_AWS_REGIONS=ap-south-1
IIPP_ALLOWED_AWS_INSTANCE_FAMILIES=t3
# Set to * explicitly to allow all verified instance families. Target IAM policies
# must permit the same families; region, ownership and saved-plan approvals still apply.

# Provider connection secret store
AWS_SECRETS_MANAGER_REGION=ap-south-1
# Extended POC: set only through protected runtime secret configuration.
# Required for Azure Windows saved plans; never place a password in tfvars or Git.
IIPP_AZURE_WINDOWS_ADMIN_PASSWORD=
# Optional authenticated customer-scoped control plane; requires a separate worker.
CONTROL_PLANE_ENABLED=false
CONTROL_PLANE_USERS_FILE=/run/iipp/users.json

# Single-workspace admin login (required when not using the identity registry).
# Generate with python tools/setup_admin.py; load .env.admin into the process.
# Keep the generated password in a password manager, never in Git or browser code.
IIPP_ADMIN_USERNAME=admin
IIPP_ADMIN_PASSWORD_HASH=
IIPP_ADMIN_SALT=
IIPP_SESSION_IDLE_SECONDS=1800
IIPP_SESSION_MAX_SECONDS=28800
IIPP_TRUSTED_PROXY_IPS=
