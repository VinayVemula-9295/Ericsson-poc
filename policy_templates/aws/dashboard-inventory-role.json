{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Read-only inventory role. Review and deploy separately in each member account.",
  "Parameters": {
    "PlatformRoleArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws[a-z-]*:iam::[0-9]{12}:role/.+"
    },
    "ExternalId": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 2,
      "MaxLength": 1224
    },
    "RoleName": {
      "Type": "String",
      "Default": "IIPPInventoryReadRole"
    }
  },
  "Resources": {
    "InventoryRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Ref": "RoleName"
        },
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "PlatformRoleArn"
                }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InventoryReadOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AccountInventoryLists",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeRegions",
                    "ec2:DescribeInstances",
                    "ec2:DescribeVpcs",
                    "eks:ListClusters",
                    "ecs:ListClusters",
                    "ecs:ListServices",
                    "lambda:ListFunctions",
                    "elasticloadbalancing:DescribeLoadBalancers",
                    "s3:ListAllMyBuckets",
                    "ec2:DescribeVolumes",
                    "autoscaling:DescribeAutoScalingGroups"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "TargetResourceStatus",
                  "Effect": "Allow",
                  "Action": [
                    "eks:DescribeCluster",
                    "ecs:DescribeClusters",
                    "ecs:DescribeServices",
                    "lambda:GetFunctionConfiguration",
                    "rds:DescribeDBInstances",
                    "eks:ListNodegroups",
                    "eks:DescribeNodegroup"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:eks:*:${AWS::AccountId}:cluster/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecs:*:${AWS::AccountId}:cluster/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ecs:*:${AWS::AccountId}:service/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lambda:*:${AWS::AccountId}:function:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:rds:*:${AWS::AccountId}:db:*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:eks:*:${AWS::AccountId}:nodegroup/*"
                    }
                  ]
                },
                {
                  "Sid": "BucketLocationOnly",
                  "Effect": "Allow",
                  "Action": "s3:GetBucketLocation",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:ResourceAccount": {
                        "Ref": "AWS::AccountId"
                      }
                    }
                  }
                },
                {
                  "Sid": "ReadWorkloadMetrics",
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:GetMetricStatistics",
                    "cloudwatch:ListMetrics"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "InventoryRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "InventoryRole",
          "Arn"
        ]
      }
    }
  }
}
