{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "ManageIIPPProviderConnectionSecretsOnly",
    "Effect": "Allow",
    "Action": ["secretsmanager:CreateSecret", "secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue", "secretsmanager:PutSecretValue", "secretsmanager:TagResource", "secretsmanager:UpdateSecret"],
    "Resource": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:innominds-iipp/connections/*"
  }]
}
